# *******************************************************************
# CONFIGURATION TEMPLATE (EMBM + GOLDSTEIN + GOLDSTEIN SEA-ICE + ATCHEM + BIOGEM)
# *******************************************************************

# *******************************************************************
# GENIE COMPONENT SELECTION
# *******************************************************************
ma_flag_ebatmos=.TRUE.
ma_flag_goldsteinocean=.TRUE.
ma_flag_goldsteinseaice=.TRUE.
ma_flag_atchem=.TRUE.
ma_flag_biogem=.TRUE.
# *******************************************************************

# *******************************************************************
# GRID CONFIGURATION
# *******************************************************************
# Topography
ma_fname_topo='cmip6lgm'
# Grid resolution of climate components
GENIENXOPTS='$(DEFINE)GENIENX=36'
GENIENYOPTS='$(DEFINE)GENIENY=36'
GOLDSTEINNLONSOPTS='$(DEFINE)GOLDSTEINNLONS=36'
GOLDSTEINNLATSOPTS='$(DEFINE)GOLDSTEINNLATS=36'
GOLDSTEINNLEVSOPTS='$(DEFINE)GOLDSTEINNLEVS=16'
# Topography for climate components
ea_topo=cmip6lgm
go_topo=cmip6lgm
gs_topo=cmip6lgm
# Assumed longitudinal offset of the grid
gm_par_grid_lon_offset=-260
# Ocean depth scalar (m) [internally, parameter: dsc]
go_par_dsc=5000
# Additional ocean layers (deeper than go_par_dsc)
go_par_dk=0
# Boundary conditions: EMBM
ea_taux_u='cmip6lgm.taux_u.dat'
ea_tauy_u='cmip6lgm.tauy_u.dat'
ea_taux_v='cmip6lgm.taux_v.dat'
ea_tauy_v='cmip6lgm.tauy_v.dat'
ea_adv_u='cmip6lgm.wvelx.dat'
ea_adv_v='cmip6lgm.wvely.dat'
# Boundary conditions: ALBEDO (planetary)
ea_par_albedo1d_name='cmip6lgm.albd_pl.dat'
# Boundary conditions: BIOGEM
bg_ctrl_force_windspeed=.true.
bg_par_pindir_name='../../cgenie.muffin/genie-paleo/cmip6lgm/'
bg_par_windspeed_file='cmip6lgm.windspeed_uvaa.dat'
# gas transfer coeff
bg_par_gastransfer_a=0.6542
# INPUT FILE PATH
ea_1='../../cgenie.muffin/genie-paleo/cmip6lgm'
go_1='../../cgenie.muffin/genie-paleo/cmip6lgm'
gs_1='../../cgenie.muffin/genie-paleo/cmip6lgm'
# Orbital parameters (21ka LGM, La2004 new orbit code)
ea_opt_orbit_old=.false.
ea_par_orbit_osce=0.018835
ea_par_orbit_oscobl=0.4008
ea_par_orbit_osclonperi=2.0112
# *******************************************************************

# *******************************************************************
# TRACER CONFIGURATION
# *******************************************************************
# the total number of tracers includes T and S
# T and S do not need to be explicitly selected and initialized
# *******************************************************************
# Set number of tracers
GOLDSTEINNTRACSOPTS='$(DEFINE)GOLDSTEINNTRACS=28'
#
# --- ATMOSPHERIC TRACERS ---
gm_atm_select_3=.true.      # pCO2 -- carbon dioxide (CO2)
gm_atm_select_4=.true.      # pCO2_13C -- d13C of CO2
gm_atm_select_5=.true.      # pCO2_14C -- d14C of CO2
gm_atm_select_6=.true.      # pO2 -- oxygen (O2)
gm_atm_select_16=.true.     # pH2S -- hydrogen sulphide (H2S)
#
# --- OCEAN TRACERS ---
gm_ocn_select_3=.true.      # DIC -- dissolved inorganic carbon
gm_ocn_select_4=.true.      # DIC_13C -- d13C of DIC
gm_ocn_select_5=.true.      # DIC_14C -- d14C of DIC
gm_ocn_select_8=.true.      # PO4 -- dissolved phosphate
gm_ocn_select_10=.true.     # O2 -- dissolved oxygen
gm_ocn_select_12=.true.     # ALK -- alkalinity
gm_ocn_select_15=.true.     # DOM_C -- dissolved organic matter; carbon
gm_ocn_select_16=.true.     # DOM_C_13C -- d13C of DOM-C
gm_ocn_select_17=.true.     # DOM_C_14C -- d14C of DOM-C
gm_ocn_select_20=.true.     # DOM_P -- dissolved organic matter; phosphorous
gm_ocn_select_22=.true.     # DOM_Fe -- dissolved organic matter; iron
gm_ocn_select_35=.true.     # Ca -- dissolved calcium
gm_ocn_select_38=.true.     # SO4 -- dissolved sulphate
gm_ocn_select_40=.true.     # H2S -- dissolved hydrogen sulphide
gm_ocn_select_42=.true.     # TL -- total dissolved ligand
gm_ocn_select_50=.true.     # Mg -- dissolved magnesium
gm_ocn_select_90=.true.     # TDFe -- total dissolved Fe
#
# --- OCEAN COLOR TRACERS (rb + colx) ---
gm_ocn_select_48=.true.     # colr -- RED numerical (color) tracer
gm_ocn_select_49=.true.     # colb -- BLUE numerical (color) tracer
gm_ocn_select_57=.true.     # col0 -- numerical (color) tracer #0 -- DIC
gm_ocn_select_58=.true.     # col1 -- numerical (color) tracer #1 -- ALK
gm_ocn_select_59=.true.     # col2 -- numerical (color) tracer #2 -- O2
gm_ocn_select_60=.true.     # col3 -- numerical (color) tracer #3 -- PO4
gm_ocn_select_64=.true.     # col7 -- numerical (color) tracer #7 -- d13C
gm_ocn_select_65=.true.     # col8 -- numerical (color) tracer #8 -- Csoft d13C
gm_ocn_select_66=.true.     # col9 -- numerical (color) tracer #9 -- Csoft
#
# --- SEDIMENT TRACERS ---
gm_sed_select_3=.true.      # POC -- particulate organic carbon
gm_sed_select_4=.true.      # POC_13C -- d13C of POC
gm_sed_select_5=.true.      # POC_14C -- d14C of POC
gm_sed_select_8=.true.      # POP -- particulate organic phosphate
gm_sed_select_10=.true.     # POFe -- particulate organic iron
gm_sed_select_13=.true.     # POM_Fe -- POM scavenged Fe
gm_sed_select_14=.true.     # CaCO3 -- calcium carbonate
gm_sed_select_15=.true.     # CaCO3_13C -- d13C of CaCO3
gm_sed_select_16=.true.     # CaCO3_14C -- d14C of CaCO3
gm_sed_select_21=.true.     # CaCO3_FeOOH -- CaCO3 scavenged FeOOH
gm_sed_select_22=.true.     # det -- detrital (refractory) material
gm_sed_select_25=.true.     # det_FeOOH -- detrital scavenged FeOOH
gm_sed_select_32=.true.     # ash
gm_sed_select_33=.true.     # POC_frac2
gm_sed_select_34=.true.     # CaCO3_frac2
gm_sed_select_36=.true.     # CaCO3_age -- CaCO3 numerical age tracer
#
# --- TRACER INITIAL VALUES ---
# Atmospheric tracers
ac_atm_init_3=278.0E-06     # pCO2 (atm)
ac_atm_init_4=-6.5          # pCO2_13C (o/oo)
ac_atm_init_6=0.2095        # pO2 (atm)
# Ocean tracers
bg_ocn_init_3=2.244E-03     # DIC (mol kg-1)
bg_ocn_init_4=0.4           # DIC_13C (o/oo)
bg_ocn_init_8=2.159E-06     # PO4 (mol kg-1)
bg_ocn_init_10=1.696E-04    # O2 (mol kg-1)
bg_ocn_init_12=2.363E-03    # ALK (mol kg-1)
bg_ocn_init_15=0.0          # DOM_C (mol kg-1)
bg_ocn_init_16=0.0          # DOM_C_13C (o/oo)
bg_ocn_init_20=0.0          # DOM_P (mol kg-1)
bg_ocn_init_22=0.0          # DOM_Fe (mol kg-1)
bg_ocn_init_42=1.000E-09    # TL (mol kg-1)
bg_ocn_init_48=0.0          # colr (n/a)
bg_ocn_init_49=0.0          # colb (n/a)
bg_ocn_init_90=0.650E-09    # TDFe (mol kg-1)
# Ocean Ca, Mg, SO4 concentrations (LGM values, mol kg-1)
bg_ocn_init_35=10.280E-03
bg_ocn_init_38=28.240E-03
bg_ocn_init_40=0.0
bg_ocn_init_50=52.820E-03
# *******************************************************************

# *******************************************************************
# PHYSICAL CLIMATE CONFIGURATION #1: main goin parameters
# *******************************************************************
# temp0
go_10=0.0
# temp1
go_11=0.0
# rel
go_12=0.9000000
# scl_tau / SclTau
go_13=1.531013488769531300
# ocean diffusivites iso (or horiz) / OcnHorizDiff
go_14=1494.438354492187500000
# ocean diffusivites dia (or vert) / OcnVertDiff
go_15=0.000025363247914356
# inverse minimum drag in days / InvDrag
go_16=2.710164785385131800
# scl_tau (should be same as GOLDSTEIN's value) / SclTau
ea_11=1.531013488769531300
# atm. diff. amp. for T / AtmDiffAmpT
ea_12=5204945.000000000000000000
# atm. diff. amp. for q / AtmDiffAmpQ
ea_13=1173269.250000000000000000
# dist'n width / AtmDiffWidthT
ea_14=1.410347938537597700
# dist'n slope / AtmDiffSlopeT
ea_15=0.090003050863742828
# atm. advection factor for T_z / AtmAdvectCoeffTm
ea_16=0.001037851092405617
# atm. advection factor for T_m / AtmAdvectCoeffQm
ea_17=0.0000000E+00
# atm. advection factor for q_z / AtmAdvectCoeffQz
ea_18=0.164652019739151000
# atm. advection factor for q_m / AtmAdvectCoeffQz
ea_19=0.164652019739151000
## extra1a
#ea_25=-2.1228021E-02
## extra1b
#ea_26=0.1202921
## extra1c
#ea_27=0.1273681
# SclFWF -- scale for zero freshwater re-balancing (LGM)
ea_28=0.0
# sea-ice eddy diffusivity / SeaiceDiff
gs_11=3573.718017578125000000
#diffusivity scaling factor
ea_diffa_scl=0.25
#grid point distance over which scalar is applied (j direction)
ea_diffa_len=3
# *******************************************************************

